# Copy to .env.local and fill in what you need. Everything is optional for
# local development except where noted; features whose keys are missing turn
# themselves off.
#
# Firebase: the web config lives in src/lib/firebase-config.js (it's public by
# design). Point it at your own project with Firestore and Authentication
# (Google + Email/Password) enabled.
# FIREBASE_PROJECT_ID=        # only if the server should verify tokens for a different project

# App
NEXT_PUBLIC_BASE_URL=https://bublr.life

# Cloudinary (image uploads). The secret stays server-side; /api/cloudinary-sign
# signs each upload for signed-in writers.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (AI moderation on publish, voice transcription, reader translation)
GROQ_API_KEY=

# Shared secret for the /api/moderate endpoints (requests are refused if unset)
MODERATION_SECRET_KEY=

# Resend (newsletter emails)
RESEND_API_KEY=
# Optional: signs newsletter unsubscribe links (defaults to RESEND_API_KEY)
UNSUBSCRIBE_SECRET=
RESEND_FROM_EMAIL="Bublr <notifications@bublr.life>"

# Polar ($2/month custom domain add-on)
POLAR_ACCESS_TOKEN=
POLAR_CUSTOM_DOMAIN_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Vercel (attaching custom domains to the project)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional search-console verification tags
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_PINTEREST_VERIFICATION=
