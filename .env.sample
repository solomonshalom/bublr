# Copy to .env.local and fill in what you need. Everything is optional for
# local development except where noted; features whose keys are missing turn
# themselves off.
#
# Firebase: the web config lives in src/lib/firebase-config.js (it's public by
# design). Point it at your own project with Firestore and Authentication
# (Google + Email/Password) enabled.
# FIREBASE_PROJECT_ID=        # only if the server should verify tokens for a different project

# App
NEXT_PUBLIC_BASE_URL=https://bublr.life

# Cloudinary (image uploads). The secret stays server-side; /api/cloudinary-sign
# signs each upload for signed-in writers.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (AI moderation on publish, voice transcription, reader translation)
GROQ_API_KEY=

# Shared secret for the /api/moderate endpoints (requests are refused if unset)
MODERATION_SECRET_KEY=

# Resend (newsletter emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Bublr <notifications@bublr.life>"

# Dodo Payments (Bublr Pro, $4.99/month: custom domain + branding + newsletter template)
# Without the API key and product ID, checkout says payments aren't set up yet.
DODO_PAYMENTS_API_KEY=
# Signing secret of the webhook endpoint pointing at /api/subscription/webhook ("whsec_...")
DODO_PAYMENTS_WEBHOOK_KEY=
# The $4.99/month subscription product ("pdt_..."). Comma-separate several to keep
# honouring an old product after a price change; the first one is sold.
DODO_PAYMENTS_PRODUCT_ID=
# "test_mode" or "live_mode". Optional: a dodo_test_ key implies test mode, and
# otherwise production builds use live mode.
DODO_PAYMENTS_ENVIRONMENT=

# Vercel (attaching writers' domains to this project). Without these, the
# custom domain page says domains aren't available yet.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional search-console verification tags
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_PINTEREST_VERIFICATION=
